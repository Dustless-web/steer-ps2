# Copy to .env for local use. Never commit .env.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8765
# Optional absolute FFmpeg executable path
FFMPEG_PATH=

# Gemini alternative: set AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
